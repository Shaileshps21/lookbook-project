# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — MongoDB Atlas connection string (see §A.13)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<name>
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=lookbook

# Auth — generate with `openssl rand -hex 48` (never commit real values)
JWT_SECRET=<random-hex-at-least-32-chars>
JWT_EXPIRES_IN=7d
COOKIE_NAME=lookbook_token

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# JWT refresh token secret — separate value, same generation method
JWT_REFRESH_SECRET=<another-random-hex-at-least-32-chars>

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-client-secret>

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

# Razorpay (test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_<key_id>
RAZORPAY_KEY_SECRET=<key_secret>
RAZORPAY_WEBHOOK_SECRET=<webhook_secret>

# Stripe for international payments
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Cloudinary (from cloudinary.com console)
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# GROQ (from console.groq.com — current key is invalid, see §A.13)
GROQ_API_KEY=gsk_<key>
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# Gemini (from aistudio.google.com — the active fallback provider)
# GEMINI_TEXT_MODEL is configurable per §13.1 so the model can be swapped
# without a redeploy.
GEMINI_API_KEY=<gemini-api-key>
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Redis (from Redis Cloud or a local redis-server; see §A.7)
REDIS_URL=redis://default:<password>@<host>:<port>

# Email (SMTP — Brevo/other provider credentials)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-pass>

# Session/2FA (used by auth flows)
SESSION_SECRET=<random-hex>

# CORS / URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Web Push / VAPID (generate with: npm run push:keys)
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>